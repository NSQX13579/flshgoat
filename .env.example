# ============================================================
# goat 机器人配置模板
# 用法：cp .env.example .env  然后按注释填写各项。
# .env 含密钥，已被 .gitignore 排除，请勿提交。
# 下方键名来自真实环境，所有值已清空。
# ============================================================

# ---------- 核心配置 ----------
# 建议只监听 127.0.0.1，端口自选一个高位端口，不要暴露公网
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["<你的QQ号>"]
NICKNAME=["梵高"]
COMMAND_START=["/",""]
ONEBOT_ACCESS_TOKEN=<你的 access_token>
DRIVER=~fastapi+~websockets+~httpx
LOCALSTORE_USE_CWD=true

# ---------- 插件配置（以下值请自行填写） ----------
# 配置 pyproject.toml


#analysis_blacklist = [123456789]  不解析里面填写的QQ号发的链接 List[int]
analysis_display_image=
#新冠疫情推送配置
covid19_message_type=
covid19=
tencentcloud_common_region=
tencentcloud_common_secretid=
tencentcloud_common_secretkey=
EX_COOKIE=
PROXY=
SEARCH_LIMIT=
RISK_CONTROL=
RECORD_PRIORITY=
caiyunai_apikey=
#词云设置
wordcloud_width=
wordcloud_height=
wordcloud_background_color=
wordcloud_font_path=
wordcloud_stopwords_path=
wordcloud_userdict_path=
wordcloud_timezone=

server_status_only_superusers=
server_status_cpu=
server_status_per_cpu=
server_status_memory=
server_status_disk=
YGO_MAX=
#cchess_engine_path=/path/to/your/engine

#60s读世界配置
#read_qq_friends=[] #设定要发送的QQ好友
#read_qq_groups=[<群号1>,<群号2>] #设定要发送的群
#read_inform_time=[{"HOUR":9,"MINUTE":1}] #在输入时间的时候 不要 以0开头如{"HOUR":06,"MINUTE":08}是错误的
#at_reminder = ["<QQ1>", "<QQ2>"]

# 以下均为百度翻译配置，见 https://fanyi-api.baidu.com/doc/21
appid=
key=
salt=
linker_group=
#图片翻译
baidu_app_id=
baidu_app_key=
#头像表情包
baidu_trans_appid=
baidu_trans_apikey=



##################################查询服务器状态配置########################################
# 全局设置
# 用来测试访问网址时的代理（默认为空）
PROXY=

# ====================
# 行为设置

# 要使用的图片模板
# 目前只有 default 可用
# 关于模板的特定配置请见下方
PS_TEMPLATE=

# 触发插件功能的指令列表（可不填）
PS_COMMAND=

# 是否只能由 SUPERUSER 触发指令（可不填）
PS_ONLY_SU=

# 触发指令是否需要 @Bot（可不填）
PS_NEED_AT=

# 是否回复目标用户（可不填）
# 使用 QQ 官方机器人时需要关闭此项（官方尚未支持回复），否则可能导致报错！
PS_REPLY_TARGET=

# 请求头像等其他 URL 时的超时时间（秒）（可不填）
PS_REQ_TIMEOUT=

# ====================
# 全局个性化设置

# 图片背景图来源（可不填）
# 当背景图获取失败时，会自动 fallback 到 "local" 来源
# 图片来源列表：
#   - "loli": LoliApi (https://docs.loliapi.com/api-shi-yong-wen-dang/sui-ji-er-ci-yuan-tu-pian/shou-ji-duan-sui-ji-tu-pian)
#   - "lolicon": Lolicon API (https://api.lolicon.app/#/setu)
#     > 注: 此来源会直接从 Pixiv 而不是反代站获取图片，如遇网络问题请自备代理
#   - "local": 本地图片
#   - "none": 无背景图
PS_BG_PROVIDER=

# 背景图预载数量（可不填）
PS_BG_PRELOAD_COUNT=

# Lolicon API 背景图来源获取图片的 R18 类型（可不填）
# 可用值：0 (哒咩 R18!)、1 (就要 R18!)、2 (U18 / R18 混合)
PS_BG_LOLICON_R18_TYPE=

# 本地背景图来源 ("local") 使用的图片文件 / 文件夹路径（默认为插件自带背景图）
# 如路径不存在，会 fallback 到插件自带默认背景图
PS_BG_LOCAL_PATH=

# 当获取 Bot 头像失败时使用的默认头像路径（可不填）
PS_DEFAULT_AVATAR=

# ====================
# 数据收集设置

# == 基础设置 ==

# PeriodicCollector 的调用间隔，单位秒
PS_COLLECT_INTERVAL=

# PeriodicCollector 中 deque 的默认大小
PS_DEFAULT_COLLECT_CACHE_SIZE=

# 设置特定 PeriodicCollector 中 deque 的大小，{ [name: string]: number }
PS_COLLECT_CACHE_SIZE=

# == header ==

# 使用 .env 中配置的 NICKNAME 作为图片上的 Bot 昵称（可不填）
PS_USE_ENV_NICK=

# 仅显示当前 Bot（可不填）
PS_SHOW_CURRENT_BOT_ONLY=

# 是否对适配器为 OneBot V11 的 Bot 调用 get_status 获取收发消息数
PS_OB_V11_USE_GET_STATUS=

# 是否使用 message_sent 事件（OneBot V11），或 user_id 为自身的消息事件统计发送消息数
# 为 False 时全局禁用，为 True 时全局启用，
# 为适配器名称列表（如 ["OneBot V11", "Telegram"]）仅对指定的适配器启用
PS_COUNT_MESSAGE_SENT_EVENT=

# 是否在 Bot 断开链接时清空收发消息计数
PS_DISCONNECT_RESET_COUNTER=

# == disk ==

# 分区列表里忽略的盘符（挂载点）（可不填）
# 使用正则表达式匹配
# 由于配置项使用JSON解析，所以需要使用双反斜杠转义，
# 如："sda\\d" 解析为 sda\d（代表 sda<一位阿拉伯数字>）；
#     "C:\\\\Windows" 解析为 C:\\Windows（代表 C:\Windows）
PS_IGNORE_PARTS=

# 忽略获取容量状态失败的磁盘分区（可不填）
PS_IGNORE_BAD_PARTS=

# 是否排序分区列表（按照已用大小比例倒序）（可不填）
PS_SORT_PARTS=

# 是否反转分区列表排序（可不填）
PS_SORT_PARTS_REVERSE=

# 磁盘 IO 统计列表中忽略的磁盘名（可不填）
# 使用正则表达式匹配（注意事项同上）
PS_IGNORE_DISK_IOS=

# 是否忽略 IO 都为 0B/s 的磁盘（可不填）
PS_IGNORE_NO_IO_DISK=

# 是否排序磁盘 IO 统计列表（按照读写速度总和倒序）（可不填）
PS_SORT_DISK_IOS=

# == network ==

# 网速列表中忽略的网络名称（可不填）
# 使用正则表达式匹配（注意事项同上）
PS_IGNORE_NETS=

# 是否忽略上下行都为 0B/s 的网卡（可不填）
PS_IGNORE_0B_NET=

# 是否排序网速列表（按照上下行速度总和倒序）（可不填）
PS_SORT_NETS=

# 需要进行测试响应速度的网址列表（可不填）
# 字段说明：
#   - name: 显示名称
#   - url: 测试网址
#   - use_proxy: 是否使用插件配置中的代理访问（可不填，默认为 false）
PS_TEST_SITES=

# 是否将测试网址的结果排序（按照响应时间正序）（可不填）
PS_SORT_SITES=

# 网址测试访问时的超时时间（秒）（可不填）
PS_TEST_TIMEOUT=

# == process ==

# 进程列表的最大项目数量（可不填）
PS_PROC_LEN=

# 要忽略的进程名（可不填）
# 使用正则表达式匹配（注意事项同上）
PS_IGNORE_PROCS=

# 进程列表的排序方式（可不填）
# 可选：cpu、mem
PS_PROC_SORT_BY=

# 是否将进程 CPU 占用率显示为类似 Windows 任务管理器的百分比（最高 100%）（可不填）
# 例：当你的 CPU 总共有 4 线程时，如果该进程吃满了两个线程，
# Linux 会显示为 200%（每个线程算 100%），而 Windows 会显示为 50%（总占用率算 100%）
PS_PROC_CPU_MAX_100P=

# ====================
# default 模板特定配置

# 图片中渲染的组件列表及其排列顺序（可不填）
# 默认启用全部组件
# 组件介绍：
#   - "header": 已连接的 Bot 信息、NoneBot 运行时间、系统运行时间
#   - "cpu_mem": CPU、MEM、SWAP 使用率圆环图
#   - "disk": 分区占用情况、磁盘 IO 情况
#   - "network": 网络 IO 情况、网络响应速度测试
#   - "process": 进程 CPU、MEM 占用情况
#   - "footer": NoneBot 与 PicStatus 版本、当前时间、Python 实现及版本、系统名称及架构
PS_DEFAULT_COMPONENTS=

# 向模板中附加的 CSS 路径列表（默认为空）
# 如要使用插件内置 CSS，请使用 res: 前缀
# 内置 CSS 列表：
#   - "res:theme-dark.css": 深色主题
#   - "res:no-blur.css": 禁用卡片毛玻璃效果
#   - “res:no-radius.css”: 禁用圆角
#   - “res:no-shadow.css”: 禁用阴影
# Tip:
#   可以在 Bot 工作目录下新建一个名为 debug 的文件夹，
#   当检测到存在此文件夹时，渲染出来的 HTML 会被写进 debug/picstatus 文件夹中，方便调试
PS_DEFAULT_ADDITIONAL_CSS=

# 向模板中附加的 JS 脚本路径列表（默认为空）
# 暂无内置 JS 脚本可供使用
# 编写方式请参考 res/js/index.js
PS_DEFAULT_ADDITIONAL_SCRIPT=

# 输出的图片格式（可不填）
# 可选：jpeg、png
PS_DEFAULT_PIC_FORMAT=
############################################################################################


